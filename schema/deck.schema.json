{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/live-office-ppt/deck.schema.json",
  "title": "Live Office PPT Deck Spec",
  "description": "Deck spec checked by schema/deck.schema.json and validate-deck.py. The schema covers types, required fields, #RRGGBB colors, and positive width and height. Fitting a shape inside the page, unique asset ids, asset references, and local image files depend on other values, so validate-deck.py checks those after the schema passes.",
  "type": "object",
  "required": ["slides"],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "page": {
      "$ref": "#/$defs/page"
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "assets": {
      "description": "must be an array of assets or a map of asset id to asset",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/assetWithoutRequiredId"
          }
        }
      ]
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "$defs": {
    "color": {
      "description": "a #RRGGBB color",
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "point": {
      "type": "number",
      "minimum": 0
    },
    "positiveLength": {
      "description": "A length greater than 0, in PowerPoint points.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "page": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "width": {
          "description": "Page width in PowerPoint points. Defaults to 960 when omitted.",
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 960
        },
        "height": {
          "description": "Page height in PowerPoint points. Defaults to 540 when omitted.",
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 540
        },
        "background": {
          "$ref": "#/$defs/color"
        },
        "theme": {
          "$ref": "#/$defs/theme"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "font": {
          "type": "string"
        }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["image"]
        },
        "source": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string"
        }
      }
    },
    "assetWithoutRequiredId": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["image"]
        },
        "source": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string"
        }
      }
    },
    "slide": {
      "type": "object",
      "required": ["elements"],
      "additionalProperties": true,
      "properties": {
        "background": {
          "$ref": "#/$defs/color"
        },
        "notes": {
          "type": "string"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      }
    },
    "element": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["text", "title", "box", "shape", "line", "connector", "image", "sleep"]
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": ["text", "title"]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/textElement"
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": ["box", "shape"]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/shapeElement"
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": ["line", "connector"]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/lineElement"
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": ["image"]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/imageElement"
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": ["sleep"]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/sleepElement"
          }
        }
      ]
    },
    "position": {
      "description": "x and y are measured from the top-left of the page and must be greater than or equal to 0. w and h must be greater than 0. validate-deck.py checks x + w and y + h against the page size.",
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {
          "$ref": "#/$defs/point"
        },
        "y": {
          "$ref": "#/$defs/point"
        },
        "w": {
          "$ref": "#/$defs/positiveLength"
        },
        "h": {
          "$ref": "#/$defs/positiveLength"
        }
      }
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "text": {
          "type": "string"
        },
        "font": {
          "type": "string"
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "bold": {
          "type": "boolean"
        },
        "align": {
          "type": "string",
          "enum": ["left", "center", "right"]
        },
        "valign": {
          "type": "string",
          "enum": ["top", "middle", "center", "bottom"]
        }
      }
    },
    "lineStyle": {
      "description": "must be \"none\" or a line object",
      "oneOf": [
        {
          "type": "string",
          "enum": ["none"]
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "color": {
              "$ref": "#/$defs/color"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "beginArrow": {
              "$ref": "#/$defs/arrow"
            },
            "endArrow": {
              "$ref": "#/$defs/arrow"
            }
          }
        }
      ]
    },
    "arrow": {
      "type": "string",
      "enum": ["none", "triangle", "stealth", "oval", "diamond"]
    },
    "fillStyle": {
      "description": "must be \"none\", a #RRGGBB color, or a fill object",
      "oneOf": [
        {
          "type": "string",
          "enum": ["none"]
        },
        {
          "$ref": "#/$defs/color"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "color": {
              "$ref": "#/$defs/color"
            },
            "transparency": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "shapeName": {
      "type": "string",
      "enum": [
        "rect",
        "rectangle",
        "roundRect",
        "roundedRectangle",
        "oval",
        "circle",
        "diamond",
        "triangle",
        "hexagon",
        "parallelogram"
      ]
    },
    "textElement": {
      "allOf": [
        {
          "$ref": "#/$defs/position"
        },
        {
          "$ref": "#/$defs/textStyle"
        },
        {
          "type": "object",
          "required": ["text"]
        }
      ]
    },
    "shapeElement": {
      "allOf": [
        {
          "$ref": "#/$defs/position"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "shape": {
              "$ref": "#/$defs/shapeName"
            },
            "text": {
              "description": "must be a string or a text style object",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/textStyle"
                }
              ]
            },
            "fill": {
              "$ref": "#/$defs/fillStyle"
            },
            "line": {
              "$ref": "#/$defs/lineStyle"
            }
          }
        }
      ]
    },
    "lineElement": {
      "description": "must include from and to, or x1, y1, x2, and y2",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "connector": {
          "type": "string",
          "enum": ["straight", "elbow", "curve"]
        },
        "from": {
          "$ref": "#/$defs/pointPair"
        },
        "to": {
          "$ref": "#/$defs/pointPair"
        },
        "x1": {
          "$ref": "#/$defs/point"
        },
        "y1": {
          "$ref": "#/$defs/point"
        },
        "x2": {
          "$ref": "#/$defs/point"
        },
        "y2": {
          "$ref": "#/$defs/point"
        },
        "line": {
          "$ref": "#/$defs/lineStyle"
        }
      },
      "anyOf": [
        {
          "required": ["from", "to"]
        },
        {
          "required": ["x1", "y1", "x2", "y2"]
        }
      ]
    },
    "pointPair": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/point"
        },
        {
          "$ref": "#/$defs/point"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "imageElement": {
      "allOf": [
        {
          "$ref": "#/$defs/position"
        },
        {
          "description": "must include asset or path",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "asset": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "fit": {
              "type": "string",
              "enum": ["cover", "contain", "stretch", "original"]
            },
            "line": {
              "$ref": "#/$defs/lineStyle"
            },
            "frame": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "shape": {
                  "$ref": "#/$defs/shapeName"
                },
                "fill": {
                  "$ref": "#/$defs/fillStyle"
                },
                "line": {
                  "$ref": "#/$defs/lineStyle"
                }
              }
            }
          },
          "anyOf": [
            {
              "required": ["asset"]
            },
            {
              "required": ["path"]
            }
          ]
        }
      ]
    },
    "sleepElement": {
      "type": "object",
      "required": ["ms"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "sleep"
        },
        "ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
